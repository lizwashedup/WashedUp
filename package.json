{
  "name": "washedup-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:clean": "rm -rf node_modules/.cache .expo && expo start --clear",
    "build:ios": "npx expo prebuild --clean && npx expo run:ios",
    "build:android": "npx expo prebuild --clean && npx expo run:android",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "ota:guard": "bash scripts/ota-guard.sh",
    "ota:ios": "bash scripts/publish-ota.sh ios",
    "ota:android": "bash scripts/publish-ota.sh android",
    "test": "jest",
    "typecheck": "tsc --noEmit --pretty false",
    "qa": "npm run qa:all",
    "qa:all": "npm run qa:release-policy && npm run qa:auth-regression && npm run qa:traceability && npm run typecheck && npm run qa:test && npm run qa:confirmations && npm run qa:notifications && npm run qa:payouts && npm run qa:ticketing && npm run qa:deliverability:local && npm run qa:consent-sync:local && npm run test:db:static && npm run qa:migration-inventory && npm run qa:migration-drift",
    "qa:release-policy": "node --test scripts/release/migration-policy.test.mjs && node scripts/release/migration-policy.mjs",
    "qa:auth-regression": "jest --runInBand --ci lib/__tests__/phoneFormat.test.ts lib/__tests__/authRouting.test.ts && node scripts/release/check-auth-invariants.mjs && sh scripts/db-contracts/run-private-sql-contracts.sh consent-sync",
    "qa:confirmations": "deno test --no-remote --no-config supabase/functions/_tests/confirmationRetry_test.ts supabase/functions/_tests/rsvpConfirmation_test.ts supabase/functions/_tests/deliveryPolicy_test.ts",
    "qa:notifications": "deno test --no-remote --no-config supabase/functions/_tests/runTokenAuth_test.ts supabase/functions/_tests/pushFailureDiagnosis_test.ts",
    "qa:payouts": "deno test --no-remote --no-config supabase/functions/_tests/payoutReconciliation_test.ts supabase/functions/_tests/payoutBatchClaim_test.ts",
    "qa:ticketing": "deno test --no-remote --no-config supabase/functions/_tests/webhookVerification_test.ts supabase/functions/_tests/ticketCheckout_test.ts supabase/functions/_tests/organizerOnboarding_test.ts",
    "qa:75": "bash scripts/verify-75-threshold.sh local",
    "qa:75:live": "bash scripts/verify-75-threshold.sh live",
    "qa:75:db": "sh scripts/db-contracts/run-private-sql-contracts.sh threshold-75",
    "qa:deliverability:db": "sh scripts/db-contracts/run-private-sql-contracts.sh deliverability",
    "qa:deliverability:local": "deno test --no-remote --no-config scripts/deliverability/operator-summary_test.ts && deno run --no-remote --no-config scripts/deliverability/local-canary.ts",
    "qa:consent-sync:db": "sh scripts/db-contracts/run-private-sql-contracts.sh consent-sync",
    "qa:consent-sync:local": "jest --runInBand --ci lib/deliverability/__tests__/consentSync.test.ts && deno test --no-remote --no-config supabase/functions/_tests/audienceSync_test.ts supabase/functions/_tests/suppressionPayload_test.ts supabase/functions/_tests/svixVerification_test.ts && node scripts/deliverability/check-consent-sync-wiring.mjs && deno check supabase/functions/add-to-resend-audience/index.ts supabase/functions/audience-sync-drain/index.ts supabase/functions/resend-suppression-webhook/index.ts && deno run --no-remote --no-config scripts/deliverability/local-canary.ts",
    "qa:g0:db": "sh scripts/db-contracts/run-private-sql-contracts.sh delivery-scheduler && sh scripts/db-contracts/run-private-sql-contracts.sh deliverability && sh scripts/db-contracts/run-private-sql-contracts.sh consent-sync",
    "qa:g0:local": "node scripts/deliverability/check-g0-rollout.mjs && npm run qa:consent-sync:local && deno check --no-config supabase/functions/transactional-email-drain/index.ts",
    "qa:migration-inventory": "sh scripts/db-contracts/test-release-inventory.sh",
    "qa:migration-drift": "sh scripts/db-contracts/test-drift-classifier.sh",
    "qa:test": "jest --runInBand --ci",
    "qa:traceability": "node qa/check-traceability.cjs",
    "test:db:static": "node scripts/db-contracts/static-contracts.mjs",
    "test:db:private": "sh scripts/db-contracts/run-private-sql-contracts.sh"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\.claude/worktrees/"
    ],
    "setupFilesAfterEnv": [
      "./qa/jest.after-env.cjs"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(?:\\.deno|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/config": "^12.0.13",
    "@expo/vector-icons": "^15.0.3",
    "@giphy/react-native-sdk": "^5.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.97.0",
    "@tanstack/react-query": "^5.90.21",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-audio": "~1.1.1",
    "expo-calendar": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-haptics": "^15.0.8",
    "expo-image": "^3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-updates": "~29.0.16",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "^0.575.0",
    "nativewind": "^4.2.2",
    "onesignal-expo-plugin": "^2.5.0",
    "posthog-react-native": "^4.44.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-places-autocomplete": "^2.6.4",
    "react-native-map-link": "^3.11.0",
    "react-native-maps": "1.20.1",
    "react-native-onesignal": "^5.4.4",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19",
    "unicode-emoji-json": "^0.9.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
